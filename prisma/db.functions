name: create_user_on_signup
schema: public
return type: trigger
security: definer


begin
insert into public.user(id,email,fullname,image,provider)
values(
  new.id ,
  new.email,
  COALESCE(new.raw_user_meta_data ->> 'full_name',new.raw_user_meta_data ->> 'name'),
  new.raw_user_meta_data ->> 'avatar_url',
  new.raw_app_meta_data ->> 'provider'
);
return new;
end;

